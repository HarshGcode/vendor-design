lready available&#10;in HomeLane&#x27;s warehouse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="380" height="80" as="geometry" /></mxCell><mxCell id="n22" value="Warehouse Inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="240" width="380" height="46" as="geometry" /></mxCell><mxCell id="n23" value="Customer Order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="302" width="380" height="46" as="geometry" /></mxCell><mxCell id="n24" value="Warehouse Picks Material" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="364" width="380" height="46" as="geometry" /></mxCell><mxCell id="n25" value="Factory / Installation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="426" width="380" height="46" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n29" value="Examples: Boards, hinges, hardware,&#10;standard inventory items" style="rounded=1;whiteSpa