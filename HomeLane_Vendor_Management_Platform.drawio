x="1" parent="1"><mxGeometry x="60" y="100" width="380" height="40" as="geometry" /></mxCell><mxCell id="n6" value="Products are manufactured only after the&#10;customer places an order. Every order can be&#10;customized to the customer&#x27;s requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="380" height="80" as="geometry" /></mxCell><mxCell id="n7" value="Customer Order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="380" height="46" as="geometry" /></mxCell><mxCell id="n8" value="Purchase Order (PO) to Vendor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="380" height="46" as="geometry" /></mxCell><mxCell id="n9" value="Vendor Manufactures Product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="380" height="46" as="geometry" /></mxCell><mxCell id="n10" value="Product Sent to HomeLane Factory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="426" width="380" height="46" as="geometry" /></mxCell><mxCell id="n11" value="Quality Check / Processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="488" width="380" height="46" as="geometry" /></mxCell><mxCell id="n12" value="Installation at Customer Site" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#6c8ebf;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="380" height="46" as="geometry" /></mxCell><mxCell id