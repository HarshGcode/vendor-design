 Subhodeep, but the underlying PO entity&#10;fields are very likely identical either way." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b584e;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="1300" height="150" as="geometry" /></mxCell><mxCell id="n5" value="PO HEADER FIELDS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="600" height="32" as="geometry" /></mxCell><mxCell id="n6" value="poNumber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#999999;fontSize=10;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="180" height="32" as="geometry" /></mxCell><mxCell id="n7" value="4800117816" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="240" y="252" width="420" height="32" as="geometry" /></mxCell><mxCell id="n8" value="poReleaseDate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#999999;fontSize=10;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="180" height="32" as="geometry" /></mxCell><mxCell id="n9" value="0000-00-00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="240" y="284" width="420" height="32" as="geometry" /></mxCell><mxCell id="n10" value="poReleaseTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#999999;fontSize=10;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="316" width="180" height="32" as="geometry" /></mxCell><mxCell id="n11" value="00:00:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="240" y="316" width="420" height="32" as="geometry" /><